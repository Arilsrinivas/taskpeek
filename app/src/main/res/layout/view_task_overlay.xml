<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/overlay_fullscreen_bg"
    android:clickable="true"
    android:focusable="false"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="56dp"
    android:paddingBottom="80dp">

    <!-- Upper Right: Current Date -->
    <TextView
        android:id="@+id/tvOverlayDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/overlay_text_secondary"
        android:textSize="13.5sp"
        android:text="Sun, 19 Oct 2026"
        android:layout_marginBottom="32dp" />

    <!-- Subheading: TODAY'S TASKS -->
    <TextView
        android:id="@+id/tvOverlaySubheader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="T O D A Y &apos; S   T A S K S"
        android:textColor="@color/overlay_text_muted"
        android:textSize="11sp"
        android:letterSpacing="0.25"
        android:textStyle="bold"
        android:layout_marginBottom="14dp" />

    <!-- Main Headline: Let's make progress today. -->
    <TextView
        android:id="@+id/tvHeadline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Let&apos;s make&#10;progress today."
        android:textColor="@color/overlay_text_primary"
        android:textSize="38sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:lineSpacingMultiplier="0.95"
        android:layout_marginBottom="40dp" />

    <!-- Task List Container -->
    <LinearLayout
        android:id="@+id/tasksContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Empty State View -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="No pending tasks for today"
        android:textColor="@color/overlay_text_muted"
        android:textSize="16sp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone" />

    <!-- Bottom Section: Inspirational Quote & Accent Line -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="64dp">

        <TextView
            android:id="@+id/tvQuoteLine1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S M A L L   S T E P S   E V E R Y   D A Y"
            android:textColor="@color/overlay_text_secondary"
            android:textSize="10.5sp"
            android:letterSpacing="0.2"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvQuoteLine2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="L E A D   T O   B I G   R E S U L T S"
            android:textColor="@color/overlay_text_secondary"
            android:textSize="10.5sp"
            android:letterSpacing="0.2"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="38dp"
            android:layout_height="1.5dp"
            android:background="@color/overlay_bottom_line"
            android:layout_marginTop="16dp" />
    </LinearLayout>

</LinearLayout>
